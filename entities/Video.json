{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "channel_name": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number"
    },
    "view_count": {
      "type": "number"
    },
    "video_type": {
      "type": "string",
      "enum": [
        "highlight",
        "interview",
        "full_fight",
        "press_conference",
        "weigh_in",
        "breakdown",
        "preview",
        "other"
      ]
    },
    "discipline": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "fighter_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "youtube_id": {
      "type": "string"
    },
    "data_source": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "url"
  ]
}